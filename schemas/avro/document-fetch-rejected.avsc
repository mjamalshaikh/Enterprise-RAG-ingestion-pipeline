{
  "type": "record",
  "name": "DocumentFetchRejected",
  "namespace": "com.enterprise.rag.ingestion.v1",
  "doc": "A deterministic fetch-stage validation failure sent to the document-fetcher DLQ.",
  "fields": [
    {"name": "event_id", "type": "string"},
    {"name": "event_type", "type": "string"},
    {"name": "occurred_at", "type": "string"},
    {"name": "correlation_id", "type": "string"},
    {"name": "causation_id", "type": "string"},
    {"name": "tenant_id", "type": "string"},
    {"name": "document_id", "type": "string"},
    {"name": "payload_uri", "type": "string"},
    {"name": "inspection_status", "type": "string"},
    {"name": "inspection_metadata", "type": "string"},
    {"name": "schema_version", "type": "string", "default": "1.0.0"}
  ]
}
