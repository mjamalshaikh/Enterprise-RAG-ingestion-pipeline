# Non-secret defaults for worker containers on Docker's internal_network.
# Secrets are supplied separately from secrets/local-runtime-secrets.env.
# Select one committed, non-secret config/workers/<worker>.env profile too.
# Container images select this profile with RAG_CONFIG_PROFILE=container.
RAG_OBSERVABILITY_MODE=console
RAG_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
RAG_APICURIO_URL=http://apicurio-registry:8080
RAG_MINIO_ENDPOINT=minio:9000
RAG_MINIO_SECURE=false
RAG_QDRANT_URL=http://qdrant:6333
RAG_QDRANT_COLLECTION=rag_chunks_bge_m3_v1
RAG_BGE_MODEL_NAME=BAAI/bge-m3
RAG_OTEL_SERVICE_NAME=rag-ingestion
RAG_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
RAG_OTEL_TRACES_SAMPLER=parentbased_traceidratio
RAG_OTEL_TRACES_SAMPLER_ARG=1.0
