# Non-secret defaults for Python processes running directly on the host.
# Secrets are loaded from secrets/local-runtime-secrets.env or process environment.
# Settings loads this host profile by default. Set RAG_CONFIG_PROFILE=container
# for a containerized local process.
RAG_OBSERVABILITY_MODE=console_and_otlp # console, otlp, or console_and_otlp
RAG_TRACING_ENABLED=false
RAG_OTEL_METRICS_EXPORT_INTERVAL_SECONDS=15
RAG_KAFKA_BOOTSTRAP_SERVERS=localhost:29092
RAG_KAFKA_TOPIC_PARTITIONS=1
RAG_KAFKA_TOPIC_REPLICATION_FACTOR=1
RAG_API_MAX_UPLOAD_BYTES=52428800
RAG_MINIO_ENDPOINT=localhost:9000
RAG_MINIO_SECURE=false
RAG_QDRANT_URL=http://localhost:6333
RAG_QDRANT_COLLECTION=rag_chunks_bge_m3_v1
RAG_BGE_MODEL_NAME=BAAI/bge-m3
RAG_OTEL_SERVICE_NAME=rag-ingestion
RAG_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
RAG_OTEL_TRACES_SAMPLER=parentbased_traceidratio
RAG_OTEL_TRACES_SAMPLER_ARG=1.0
