# Non-secret Docling content extractor worker profile.
RAG_WORKER_NAME=content-extractor
# This worker does not access Qdrant; do not inject a Qdrant credential.
# CPU/OCR extraction is memory-intensive. Raise only after load testing.
RAG_DOCUMENT_EXTRACTOR_MAX_CONCURRENCY=1
# Keep this above the longest allowed extraction, even though paused partitions are polled continuously.
RAG_DOCUMENT_EXTRACTOR_MAX_POLL_INTERVAL_SECONDS=3600
