# Non-secret document fetcher worker profile.
RAG_WORKER_NAME=document-fetcher
RAG_DOCUMENT_FETCHER_POLL_TIMEOUT_SECONDS=300
# Reject source PDFs before Docling when either limit is exceeded.
RAG_DOCUMENT_FETCHER_MAX_DOCUMENT_BYTES=52428800
RAG_OTEL_METRICS_EXPORT_INTERVAL_SECONDS=15
# This worker does not access Qdrant; do not inject a Qdrant credential.
