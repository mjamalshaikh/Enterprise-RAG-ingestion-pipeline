# Generated local credentials belong in secrets/local-runtime-secrets.env, never in Git.
# The provisioning script populates PostgreSQL worker passwords and Qdrant keys.
# Populate platform administrator credentials and MinIO service credentials
# manually before starting the bundled local Compose platform.
# Host Python uses this application DSN. Keep POSTGRES_APPLICATION_PASSWORD URL-safe, or
# percent-encode it here if it contains reserved URL characters such as @ or :.
RAG_POSTGRES_DSN=postgresql+asyncpg://rag_application:${POSTGRES_APPLICATION_PASSWORD}@localhost:5432/rag_ingestion
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
POSTGRES_APPLICATION_PASSWORD=
QDRANT_ADMIN_API_KEY=
QDRANT_READ_ONLY_API_KEY=
RAG_MINIO_ACCESS_KEY=
RAG_MINIO_SECRET_KEY=
RAG_MINIO_INGESTION_ACCESS_KEY=
RAG_MINIO_INGESTION_SECRET_KEY=
RAG_MINIO_API_ACCESS_KEY=
RAG_MINIO_API_SECRET_KEY=
