# Local development only — do not use these values in a deployed environment.
RAG_ENVIRONMENT=local
RAG_POSTGRES_DSN=postgresql+asyncpg://rag:rag-local-password@localhost:5432/rag_ingestion
RAG_KAFKA_BOOTSTRAP_SERVERS=localhost:29092
RAG_APICURIO_URL=http://localhost:8080
RAG_MINIO_ENDPOINT=localhost:9000
RAG_MINIO_ACCESS_KEY=minioadmin
RAG_MINIO_SECRET_KEY=change-me-minio-secret
RAG_MINIO_SECURE=false
RAG_QDRANT_URL=http://localhost:6333
RAG_QDRANT_API_KEY=change-me-qdrant-admin-key
RAG_QDRANT_READ_ONLY_API_KEY=change-me-qdrant-read-only-key
RAG_QDRANT_COLLECTION=rag_chunks_bge_m3_v1
RAG_BGE_MODEL_NAME=BAAI/bge-m3
RAG_OTEL_SERVICE_NAME=rag-ingestion
RAG_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
RAG_OTEL_TRACES_SAMPLER=parentbased_traceidratio
RAG_OTEL_TRACES_SAMPLER_ARG=1.0

POSTGRES_DB=rag_ingestion
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag-local-password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-secret
QDRANT_ADMIN_API_KEY=change-me-qdrant-admin-key
QDRANT_READ_ONLY_API_KEY=change-me-qdrant-read-only-key
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
